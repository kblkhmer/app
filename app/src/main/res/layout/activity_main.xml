<?xml version="1.0" encoding="utf-8"?>
<!-- No fitsSystemWindows: the header runs under the status bar and MainActivity applies the insets. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical">

    <!-- Header: brand gradient, logo and app name -->
    <LinearLayout
        android:id="@+id/homeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_header"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
            app:title="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:elevation="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/home_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/hanuman_family"
                    android:text="@string/app_name"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.9"
                    android:text="@string/home_tagline"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp">

            <!-- Section: lottery types -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_section_bar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/hanuman_family"
                    android:text="@string/home_subtitle"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardKhmer"
                    style="@style/Widget.LotteryKH.HomeTile"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_card_khmer">

                    <TextView
                        style="@style/Widget.LotteryKH.HomeTile.Emoji"
                        android:text="🇰🇭" />

                    <TextView
                        style="@style/Widget.LotteryKH.HomeTile.Title"
                        android:text="@string/card_khmer" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardVietnam"
                    style="@style/Widget.LotteryKH.HomeTile"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card_vietnam">

                    <TextView
                        style="@style/Widget.LotteryKH.HomeTile.Emoji"
                        android:text="🇻🇳" />

                    <TextView
                        style="@style/Widget.LotteryKH.HomeTile.Title"
                        android:text="@string/card_vietnam" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardMinhNam"
                    style="@style/Widget.LotteryKH.HomeTile"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_card_minhnam">

                    <TextView
                        style="@style/Widget.LotteryKH.HomeTile.Emoji"
                        android:text="🇻🇳" />

                    <TextView
                        style="@style/Widget.LotteryKH.HomeTile.Title"
                        android:text="@string/card_minhnam" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardThai"
                    style="@style/Widget.LotteryKH.HomeTile"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card_thai">

                    <TextView
                        style="@style/Widget.LotteryKH.HomeTile.Emoji"
                        android:text="🇹🇭" />

                    <TextView
                        style="@style/Widget.LotteryKH.HomeTile.Title"
                        android:text="@string/card_thai" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardThaiSou"
                    style="@style/Widget.LotteryKH.HomeTile"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_card_thaisou">

                    <TextView
                        style="@style/Widget.LotteryKH.HomeTile.Emoji"
                        android:text="🇹🇭" />

                    <TextView
                        style="@style/Widget.LotteryKH.HomeTile.Title"
                        android:text="@string/card_thaisou" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardPrediction"
                    style="@style/Widget.LotteryKH.HomeTile"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card_prediction">

                    <TextView
                        style="@style/Widget.LotteryKH.HomeTile.Emoji"
                        android:text="🔮" />

                    <TextView
                        style="@style/Widget.LotteryKH.HomeTile.Title"
                        android:text="@string/card_prediction" />
                </LinearLayout>
            </LinearLayout>

            <!-- YouTube Live: full width -->
            <LinearLayout
                android:id="@+id/cardYoutubeLive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_card_youtube"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_youtube_live" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/card_youtube_live"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_live_pill"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="@string/live_badge"
                    android:textColor="#D50000"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Banner Ad -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/bannerAdCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/bannerAdImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/ad_image_desc"
                    android:scaleType="fitCenter" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Latest results: section title, then one card per lottery -->
            <LinearLayout
                android:id="@+id/lastResultCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_section_bar" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/hanuman_family"
                        android:text="@string/last_result_title"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLastResultDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lastResultContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
