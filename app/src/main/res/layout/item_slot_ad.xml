<?xml version="1.0" encoding="utf-8"?>
<!-- "Live Slots" ad (banner2), shown after each draw card like the website's live page -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:visibility="gone"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/slotAdImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/ad_image_desc"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/slotAdClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_close_button"
            android:contentDescription="@string/close"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
