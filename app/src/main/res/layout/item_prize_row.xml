<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="6dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <!-- Post label (A, B, C…) in a round badge -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2">

        <TextView
            android:id="@+id/tvPrizeLabel"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_prize_label"
            android:fontFamily="@font/hanuman_family"
            android:gravity="center"
            android:minWidth="34dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- 2-digit number -->
    <TextView
        android:id="@+id/tvTwoDigit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:textColor="@color/number_dark"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- 3-digit number -->
    <TextView
        android:id="@+id/tvThreeDigit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:textColor="@color/blue_number"
        android:textSize="22sp"
        android:textStyle="bold" />

</LinearLayout>
